RUN_NAME=llama3_8b_streamtest_2node
MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
DATA_SOURCE=pile

LENS_TYPE=lora
LORA_RANK=64
LOSS_TYPE=subset_kl
SUBSET_KL_MODE=topk
SUBSET_KL_K=256
SUBSET_KL_K_TAIL=0

ACTIVATION_SITE_PRESET=residual
MULTINODE_MODEL_PARALLEL=1
STREAM_LOAD=1
REQUIRED_NNODES=2
NPROC_PER_NODE=4

NUM_STEPS=8
SAVE_EVERY=1000
LOG_EVERY=1
BATCH_SIZE=4
WARMUP_STEPS=0
LR=1e-3
TOKENS_PER_STEP=16384
MAX_SEQ_LEN=512
KL_CHUNK_SIZE=0
MODEL_DTYPE=bf16
AMP_DTYPE=bf16
SEED=0

LOG_SUBDIR=llama3_8b_streamtest
OUTPUT_DIR=/path/to/project/omnilens/src/checkpoints/llama3_8b_streamtest_2node
