# 405B lens, EXPANDED hookset (llama_expanded: 6 sites/layer = 758 total vs 126).
# 24 nodes, 1h. Proves the expanded hookset trains at 405B scale.
#
# Forced config change vs the residual run: LoRA rank 64 -> 8. The expanded
# hookset trains one LoRA translator PER SITE, so at 758 sites an r64 lens is
# ~25GB PER GPU (the lens is DDP-replicated, not FSDP-sharded, so adding nodes
# does NOT shrink it). r16 already OOMs; r8 (~3.2GB lens) + seq 96 lands at
# ~37.4GB peak, matching run 1's safe 37.1GB. seq is small for the same reason:
# expanded collects 6x the hidden states, so activation memory is 6x residual's.
RUN_NAME=llama3_405b_lora_expanded_1h
MODEL_NAME=/path/to/models/Llama-3.1-405B-Instruct-hf
DATA_SOURCE=pile

LENS_TYPE=lora
LORA_RANK=8
LOSS_TYPE=subset_kl
SUBSET_KL_MODE=topk
SUBSET_KL_K=256
SUBSET_KL_K_TAIL=0

ACTIVATION_SITE_PRESET=llama_expanded
MULTINODE_MODEL_PARALLEL=1
STREAM_LOAD=1
REQUIRED_NNODES=24
NPROC_PER_NODE=4

# 1h walltime is the real limit (~20min load + ~6 steps). SAVE_EVERY low so a
# lens survives the walltime kill.
NUM_STEPS=12
SAVE_EVERY=2
LOG_EVERY=1
BATCH_SIZE=1
MAX_SEQ_LEN=96
TOKENS_PER_STEP=1024
WARMUP_STEPS=0
LR=1e-3
KL_CHUNK_SIZE=0
MODEL_DTYPE=bf16
AMP_DTYPE=bf16
SEED=0

LOG_SUBDIR=llama3_405b
OUTPUT_DIR=/path/to/project/omnilens/src/checkpoints/llama3_405b_lora_expanded_1h
