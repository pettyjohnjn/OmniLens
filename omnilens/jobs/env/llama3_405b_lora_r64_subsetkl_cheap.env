# Cheap 405B lens: prove a lens trains on this framework at 405B scale.
# 24 nodes, <=3h. top-k subset-KL (no IS), LoRA r64, streaming FSDP loader.
#
# Efficiency notes: at 24 nodes the weight shard is 8.5GB/GPU and run 1 peaked at
# 37/40GB, so the big-batch amortization that needs 100-node (2GB) shards is not
# available here. Modest, SAFE push instead: seq 256->384 (~+0.5GB activations),
# and 1 microstep per optimizer step (tokens_per_step below one microstep's worth)
# to maximize the number of logged iterations. Est. ~25 iterations in 3h.
RUN_NAME=llama3_405b_lora_r64_subsetkl_cheap
MODEL_NAME=/path/to/models/Llama-3.1-405B-Instruct-hf
DATA_SOURCE=pile

LENS_TYPE=lora
LORA_RANK=64
LOSS_TYPE=subset_kl
SUBSET_KL_MODE=topk
SUBSET_KL_K=256
SUBSET_KL_K_TAIL=0

ACTIVATION_SITE_PRESET=residual
MULTINODE_MODEL_PARALLEL=1
STREAM_LOAD=1
REQUIRED_NNODES=24
NPROC_PER_NODE=4

# Run until walltime; SAVE_EVERY keeps a lens even if PBS kills mid-run.
NUM_STEPS=30
SAVE_EVERY=5
LOG_EVERY=1
BATCH_SIZE=1
MAX_SEQ_LEN=384
# 1 microstep/step: global tokens/microstep = 96*1*384 = 36,864 >> tokens_per_step,
# so the trainer takes exactly one microstep before each optimizer step.
TOKENS_PER_STEP=1024
WARMUP_STEPS=0
LR=1e-3
KL_CHUNK_SIZE=0
MODEL_DTYPE=bf16
AMP_DTYPE=bf16
SEED=0

LOG_SUBDIR=llama3_405b
OUTPUT_DIR=/path/to/project/omnilens/src/checkpoints/llama3_405b_lora_r64_subsetkl_cheap
