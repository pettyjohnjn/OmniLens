# Proof-of-concept: low-rank lens + subset-KL on Llama-3.1-405B-Instruct.
# Goal is to demonstrate the system trains at 405B scale and the loss decreases
# over a few steps -- NOT a full lens. Uses the streaming FSDP loader so no rank
# ever holds the full 812GB (see training/stream_load.py).
RUN_NAME=llama3_405b_lora_r64_subsetkl_poc
MODEL_NAME=/path/to/models/Llama-3.1-405B-Instruct-hf
DATA_SOURCE=pile

LENS_TYPE=lora
LORA_RANK=64
LOSS_TYPE=subset_kl
SUBSET_KL_MODE=topk
SUBSET_KL_K=256
SUBSET_KL_K_TAIL=0

ACTIVATION_SITE_PRESET=residual
MULTINODE_MODEL_PARALLEL=1
STREAM_LOAD=1
# 24 nodes x 4 = 96 ranks. 812GB / 96 = ~8.5GB weight shard per GPU; plus the
# 4.2GB unembed clone, a transient ~6.4GB layer during FSDP all-gather, and the
# ~4GB low-rank lens + Adam state that lives on every rank (the 8B run's 8.5GB peak
# confirmed that overhead) -> ~25GB/40GB. Comfortable headroom for a first run.
REQUIRED_NNODES=24
NPROC_PER_NODE=4

# A few short steps -- enough to see the loss trend down. Small batch/seq keep
# each 405B forward cheap; SAVE_EVERY high so we don't write big lens ckpts.
NUM_STEPS=8
SAVE_EVERY=1000
LOG_EVERY=1
BATCH_SIZE=1
WARMUP_STEPS=0
LR=1e-3
TOKENS_PER_STEP=2048
MAX_SEQ_LEN=256
KL_CHUNK_SIZE=0
MODEL_DTYPE=bf16
AMP_DTYPE=bf16
SEED=0

LOG_SUBDIR=llama3_405b
OUTPUT_DIR=/path/to/project/omnilens/src/checkpoints/llama3_405b_lora_r64_subsetkl_poc
