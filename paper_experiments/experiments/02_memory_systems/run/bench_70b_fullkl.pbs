#!/bin/bash
#PBS -N bench70b_fullkl
#PBS -l select=24:ncpus=32:ngpus=4
#PBS -l walltime=01:00:00
#PBS -q prod
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -A YOUR_PBS_ACCOUNT

# Tier-2 measurement: the full-KL feasibility cell.
# LoRA r64 + FULL-KL on the 70B expanded hookset, identical microbatch to the
# production Top-k+IS run (batch_size 2, seq 1024), 2 optimizer steps only —
# just enough to record true per-rank peak memory + throughput. Writes to
# benchmarks/ (never touches training checkpoints). Outcome either way is
# recorded: an OOM is itself the measurement; a ~36 GB fit quantifies how
# narrow the margin is.

REPO=/path/to/project/omnilens
MODEL=meta-llama/Llama-3.3-70B-Instruct
OUT=$REPO/benchmarks/readout_70b_fullkl
mkdir -p $OUT

MASTER_ADDR=$(head -1 $PBS_NODEFILE)
NNODES=$(sort -u $PBS_NODEFILE | wc -l)
MASTER_PORT=29531
echo "bench70b_fullkl | Nodes: $NNODES | Master: $MASTER_ADDR:$MASTER_PORT | out $OUT"

PRELOAD="module use /path/to/modulefiles; module load conda; conda activate omnilens; "
PRELOAD+="source ~/.hf_env; "
PRELOAD+="export HF_HOME=/path/to/hf_cache; "
PRELOAD+="export PYTHONPATH=$REPO/src:\$PYTHONPATH; "
PRELOAD+="export TOKENIZERS_PARALLELISM=false; export OMP_NUM_THREADS=8; "

LAUNCHER="python -m torch.distributed.run "
LAUNCHER+="--nnodes=$NNODES --nproc_per_node=4 --max_restarts 0 "
LAUNCHER+="--rdzv_backend=c10d --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} "

CMD="-m omnilens.cli.main train "
CMD+="--model_name $MODEL --multinode_model_parallel --model_dtype bf16 "
CMD+="--lens_type lora --lora_rank 64 --lora_init default_lora "
CMD+="--loss_type kl --kl_chunk_size 4096 "
CMD+="--activation_site_preset llama_expanded "
CMD+="--data_source pile --max_seq_len 1024 --batch_size 2 --tokens_per_step 262144 "
CMD+="--num_steps 2 --warmup_steps 0 --lr 1e-3 "
CMD+="--amp --amp_dtype bf16 --seed 0 "
CMD+="--save_every 1000 --log_every 1 "
CMD+="--output_dir $OUT "

RANK=0
for NODE in $(sort -u $PBS_NODEFILE); do
    FULL_CMD="cd $REPO && $PRELOAD $LAUNCHER --node_rank=$RANK $CMD"
    echo "rank $RANK -> $NODE"
    if [[ "$NODE" == "$HOSTNAME" ]]; then eval $FULL_CMD & else ssh "$NODE" "$FULL_CMD" & fi
    RANK=$((RANK + 1))
done
wait
echo "bench70b_fullkl finished; metrics:"
cat $OUT/metrics.csv 2>/dev/null || echo "(no metrics.csv — check stderr for OOM)"
