#!/bin/bash
#PBS -N inj70b_cpred
#PBS -l select=1:ncpus=32:ngpus=4
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -A YOUR_PBS_ACCOUNT

set -o pipefail
EXP=/path/to/project/memory_injections/experiments/tweak_factor_analysis
MODEL=meta-llama/Llama-3.3-70B-Instruct
CKPT=/path/to/project/lens_bundle/llama70b_lens/lens_step_250.pt
OUT=$EXP/results_llama70b_expanded

module use /path/to/modulefiles; module load conda; conda activate omnilens
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/path/to/hf_cache
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1
unset CUDA_VISIBLE_DEVICES   # shard 70B across the node's 4 GPUs
cd "$EXP"

# 70B: only the head+IS expanded lens exists. Reduced (100 ex, taus 1/2) to fit the debug hour.
echo "======== 70B expanded | lens=is_r64 | ds=2wmh | causal + lens-pred ========"
python lens_tweak_factor_analysis.py \
  --model-name "$MODEL" --checkpoint "$CKPT" \
  --lens-type lora --lora-rank 64 \
  --activation-site-preset llama_expanded --dtype bfloat16 --device-map auto \
  --dataset hand --min-tweak 0 --max-tweak 10 \
  --causal --causal-batch 32 --causal-taus 1 2 \
  --output-dir "$OUT/is_r64/hand" 2>&1 | grep -vE 'Loading weights'
echo "---- exit ${PIPESTATUS[0]} ----"
echo "70B CAUSAL+LENSPRED DONE"
