#!/bin/bash
#PBS -N inj8b
#PBS -l select=1:ncpus=32:ngpus=4
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -A YOUR_PBS_ACCOUNT

set -o pipefail
EXP=/path/to/project/memory_injections/experiments/tweak_factor_analysis
MODEL=meta-llama/Meta-Llama-3-8B-Instruct
CK=/path/to/project/omnilens/src/checkpoints
CKPT_MC=$CK/models-meta-llama-meta-llama-3-8b-instruct/lora-r64/subset_kl-is-k512-tail1024/llama_expanded/init-default/seed0/lens_step_1000.pt
CKPT_TOPK=$CK/meta-llama-3-8b-instruct/lora-r64/subset_kl-topk-k512/llama_expanded/init-default/seed0/lens_step_250.pt
OUT=$EXP/results_llama8b/injection

module use /path/to/modulefiles; module load conda; conda activate omnilens
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export CUDA_VISIBLE_DEVICES=0
cd "$EXP"

run() {  # $1=lens_tag $2=ckpt $3=dataset $4=limit(0=all) $5=max_tweak
  local lim=""; [ "$4" != "0" ] && lim="--limit $4"
  echo "======== 8B injection | lens=$1 | ds=$3 | limit=$4 | maxtweak=$5 ========"
  python lens_tweak_factor_analysis.py \
    --model-name "$MODEL" --checkpoint "$2" \
    --lens-type lora --lora-rank 64 \
    --activation-site-preset llama_expanded --dtype bfloat16 \
    --dataset "$3" --max-tweak "$5" $lim \
    --output-dir "$OUT/$1/$3" 2>&1 | grep -E '^===|Loaded|Active|Sweep|examples|ALL'
  echo "---- exit ${PIPESTATUS[0]} ----"
}

echo "###### correctness re-check (batched vs prior non-batched: expect ~0.608 @ layer28 tweak2) ######"
run is_r64 "$CKPT_MC" hand 8 3

echo "###### reduced campaign (good-enough): hand full(106), 2wmh limit 300, tweaks 1-10 ######"
run is_r64   "$CKPT_MC"   hand 0   10
run topk_r64 "$CKPT_TOPK" hand 0   10
run is_r64   "$CKPT_MC"   2wmh 300 10
run topk_r64 "$CKPT_TOPK" 2wmh 300 10
echo "ALL INJECTION RUNS DONE"
