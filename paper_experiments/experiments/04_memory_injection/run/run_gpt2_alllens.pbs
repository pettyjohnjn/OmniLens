#!/bin/bash
#PBS -N gpt2_alllens
#PBS -l select=1:ncpus=32:ngpus=4
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -A YOUR_PBS_ACCOUNT

# GPT-2 all-lens expansion + 8B DART logit (parallel on GPU 1).
#  GPU 0: GPT-2 injection (logit sweeps + causal re-runs w/ damage metrics)
#         then GPT-2 DART x4 lenses (logit / tuned full-KL / lora head+IS / lora TopK)
#  GPU 1: LLaMA-8B DART with the parameter-free logit lens

set -o pipefail
EXP=/path/to/project/memory_injections/experiments/tweak_factor_analysis
TOX=/path/to/project/interp/experiments/toxicity_ablation
CK=/path/to/project/omnilens/src/checkpoints
IS=$CK/gpt2/lora-r64/subset_kl-is-k512-tail1024/gpt2_expanded/init-default/seed0/lens_step_900.pt
TOPK=$CK/gpt2/lora-r64/subset_kl-topk-k512/gpt2_expanded/init-default/seed0/lens_step_500.pt
TUNED=$CK/gpt2/tuned/kl/gpt2_expanded/seed0/lens_step_500.pt
MODEL8B=meta-llama/Meta-Llama-3-8B-Instruct
OUT=$EXP/results_gpt2_expanded

module use /path/to/modulefiles; module load conda; conda activate omnilens
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export HF_HOME=/path/to/hf_cache
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1

# ---- GPU 1 (background): 8B DART with logit lens ----
(
  cd "$TOX"
  echo "======== 8B DART | lens=logit ========"
  CUDA_VISIBLE_DEVICES=1 python llama_dart_localization.py \
    --model-name "$MODEL8B" --lens-type logit \
    --activation-site-preset llama_expanded --dtype bfloat16 --n-prompts 200 \
    --out-csv results_llama8b/dart/toxic_heads_logit.csv 2>&1 | grep -E 'prompts|Saved|Top-5|L[0-9]|logit'
  echo "---- 8B dart logit exit ${PIPESTATUS[0]} ----"
) &
DART8B_PID=$!

# ---- GPU 0 (foreground): GPT-2 everything ----
export CUDA_VISIBLE_DEVICES=0
cd "$EXP"

# $1=tag $2=ckpt_flag $3=lens_type $4=dataset $5=extra_flags
run() {
  echo "======== GPT-2 expanded | lens=$1 | ds=$4 | $5 ========"
  python lens_tweak_factor_analysis.py \
    --model-name gpt2 $2 \
    --lens-type "$3" --lora-rank 64 \
    --activation-site-preset gpt2_expanded --dtype float32 \
    --dataset "$4" --min-tweak 0 --max-tweak 10 --limit 300 \
    --output-dir "$OUT/$1/$4" $5 2>&1 | grep -E '^===|causal|Saved|Loaded|Using|Active|Sweep|best causal'
  echo "---- exit ${PIPESTATUS[0]} ----"
}

# logit-lens readout sweeps (new lens variant, both datasets)
run logit "" logit 2wmh ""
run logit "" logit hand ""

# causal re-runs (lens-independent) to add damage columns: KL vs clean, top-1 retention
run is_r64 "--checkpoint $IS" lora 2wmh "--causal --causal-only --causal-batch 16 --causal-taus 1 2 4"
run is_r64 "--checkpoint $IS" lora hand "--causal --causal-only --causal-batch 16 --causal-taus 1 2 4"

# GPT-2 DART across all four lens variants
cd "$TOX"
dart() {
  echo "======== GPT-2 DART | lens=$1 ========"
  python llama_dart_localization.py \
    --model-name gpt2 --lens-type "$2" $3 \
    --activation-site-preset gpt2_expanded --dtype float32 --n-prompts 200 \
    --out-csv "results_gpt2/dart/toxic_heads_$1.csv" 2>&1 | grep -E 'prompts|Saved|Top-5|L[0-9]|Loaded|Using'
  echo "---- exit ${PIPESTATUS[0]} ----"
}
dart logit    logit ""
dart tuned    tuned "--checkpoint $TUNED"
dart is_r64   lora  "--checkpoint $IS"
dart topk_r64 lora  "--checkpoint $TOPK"

wait $DART8B_PID
echo "GPT2 ALLLENS + 8B DART LOGIT DONE"
