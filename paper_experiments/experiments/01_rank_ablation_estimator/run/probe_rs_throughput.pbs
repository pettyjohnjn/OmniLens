#!/bin/bash
#PBS -N rsprobe
#PBS -A YOUR_PBS_ACCOUNT
#PBS -l select=1:system=YOUR_PBS_SYSTEM:ngpus=4
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -j oe
#PBS -o /path/to/project/omnilens/logs/

# Throughput/peak-memory probe for the RS (k_head=0 teacher-sampling) baseline
# in the SAME measurement context as every other Tok/s / Peak-GB cell of
# Table 2: one full node per run, torchrun DDP over 4 GPUs, identical batch
# recipe (32x1024, tokens_per_step 2^18). 50 steps is plenty for steady-state
# throughput. The is512 anchor re-measures the known 512+512 config to confirm
# the probe reproduces the original sweep's numbers (~21.7k tok/s, ~12.0 GB).
# Outputs go to a NEW probe tree; the real seed checkpoints are untouched.

set -uo pipefail
REPO=/path/to/project/omnilens
PROBE=$REPO/src/checkpoints/probe_rs_ddp_throughput

module use /path/to/modulefiles
module load conda
conda activate omnilens
source ~/.hf_env
export HF_HOME=/path/to/hf_cache
export PYTHONPATH=$REPO/src:${PYTHONPATH:-}
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8

cd $REPO
mkdir -p logs "$PROBE"

COMMON="--model_name gpt2 --data_source pile --activation_site_preset residual \
 --max_seq_len 1024 --batch_size 32 --tokens_per_step 262144 --num_steps 50 \
 --warmup_steps 0 --lr 1e-3 --amp --amp_dtype bf16 --save_every 1000 --log_every 10 \
 --seed 0 --base_output_dir $PROBE"
LORA="--lens_type lora --lora_rank 64 --lora_init default_lora"

probe() {  # name loss-args...
  local name=$1; shift
  echo "======== probe $name ========"
  torchrun --standalone --nnodes=1 --nproc_per_node=4 \
    -m omnilens.cli.main train $COMMON $LORA "$@" \
    > "$REPO/logs/probe_rs_${name}.log" 2>&1
  echo "probe $name rc=$? ; steady-state tok/s and peak:"
  grep -o "tok/s=[0-9]*" "$REPO/logs/probe_rs_${name}.log" | tail -3
  grep -o "mem=[0-9.]*GB" "$REPO/logs/probe_rs_${name}.log" | sort -u | tail -2
}

probe is512_anchor --loss_type subset_kl --subset_kl_mode is --subset_kl_k 512 --subset_kl_k_tail 512
probe rs512        --loss_type subset_kl --subset_kl_mode is --subset_kl_k 0   --subset_kl_k_tail 512
probe rs1024       --loss_type subset_kl --subset_kl_mode is --subset_kl_k 0   --subset_kl_k_tail 1024
probe rs1536       --loss_type subset_kl --subset_kl_mode is --subset_kl_k 0   --subset_kl_k_tail 1536

echo "RS THROUGHPUT PROBE DONE"
