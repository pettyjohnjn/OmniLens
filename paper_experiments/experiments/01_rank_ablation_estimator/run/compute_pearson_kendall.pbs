#!/bin/bash
#PBS -N gpt2_pearson_kendall_token_level
#PBS -l select=1:system=YOUR_PBS_SYSTEM
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=YOUR_PBS_FILESYSTEMS
#PBS -A YOUR_PBS_ACCOUNT
#PBS -j oe

set -euo pipefail

cd /path/to/project/eval_harness

module use /path/to/modulefiles
module load conda
conda activate tuned_lens_env

export HF_HOME="/path/to/hf_cache"
export HF_HUB_CACHE="${HF_HOME}/hub"
export TRANSFORMERS_CACHE="${HF_HOME}/transformers"
export HF_DATASETS_CACHE="${HF_HOME}/datasets"
export XDG_CACHE_HOME="/path/to/cache"
export PYTHONPATH="/path/to/project/packages/subset-kl/src:/path/to/project/eval_harness:/path/to/project/omnilens/src:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
export RAYON_NUM_THREADS="${RAYON_NUM_THREADS:-1}"
export MPLCONFIGDIR="/tmp/matplotlib-${USER:-omnilens}"

MODEL_NAME="${MODEL_NAME:-gpt2}"
BASELINE_CHECKPOINT="${BASELINE_CHECKPOINT:-}"
CHECKPOINT_ROOTS="${CHECKPOINT_ROOTS:-}"
TOKENS="${TOKENS:-131072}"
MAX_RAW_DOCS="${MAX_RAW_DOCS:-8192}"
POSITIONS="${POSITIONS:-8192}"
KENDALL_K="${KENDALL_K:-100}"
BATCH_SIZE="${BATCH_SIZE:-1}"
MAX_SEQ_LEN="${MAX_SEQ_LEN:-1024}"
DATA_NAME="${DATA_NAME:-test}"
OUT_DIR="${OUT_DIR:-/path/to/project/eval_harness/evaluation/gpt2_preemptable_sweep_1000/plots/pearson_kendall_token_level}"
DTYPE="${DTYPE:-bfloat16}"
FAMILIES="${FAMILIES:-lora_full lora_topk lora_head_is tuned_topk tuned_head_is}"
RANKS="${RANKS:-}"
RUN_REGEX="${RUN_REGEX:-}"
EXCLUDE_RUN_REGEX="${EXCLUDE_RUN_REGEX:-}"

EXTRA_ARGS=()
if [[ -n "${FAMILIES}" ]]; then
  read -r -a FAMILIES_ARRAY <<< "${FAMILIES}"
  EXTRA_ARGS+=(--families "${FAMILIES_ARRAY[@]}")
fi
if [[ -n "${BASELINE_CHECKPOINT}" ]]; then
  EXTRA_ARGS+=(--baseline-checkpoint "${BASELINE_CHECKPOINT}")
fi
if [[ -n "${CHECKPOINT_ROOTS}" ]]; then
  read -r -a CHECKPOINT_ROOTS_ARRAY <<< "${CHECKPOINT_ROOTS}"
  EXTRA_ARGS+=(--checkpoint-roots "${CHECKPOINT_ROOTS_ARRAY[@]}")
fi
if [[ -n "${RANKS}" ]]; then
  read -r -a RANKS_ARRAY <<< "${RANKS}"
  EXTRA_ARGS+=(--ranks "${RANKS_ARRAY[@]}")
fi
if [[ -n "${RUN_REGEX}" ]]; then
  EXTRA_ARGS+=(--run-regex "${RUN_REGEX}")
fi
if [[ -n "${EXCLUDE_RUN_REGEX}" ]]; then
  EXTRA_ARGS+=(--exclude-run-regex "${EXCLUDE_RUN_REGEX}")
fi

python compute_gpt2_pearson_kendall_token_level.py \
  --model-name "${MODEL_NAME}" \
  --step "${STEP:-1000}" \
  --tokens "${TOKENS}" \
  --max-raw-docs "${MAX_RAW_DOCS}" \
  --positions "${POSITIONS}" \
  --kendall-k "${KENDALL_K}" \
  --batch-size "${BATCH_SIZE}" \
  --max-seq-len "${MAX_SEQ_LEN}" \
  --data-name "${DATA_NAME}" \
  --dtype "${DTYPE}" \
  --out-dir "${OUT_DIR}" \
  "${EXTRA_ARGS[@]}"
